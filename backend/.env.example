# Copy this file to .env and change the values before deploying

PORT=5000

# Supabase Postgres connection string.
# Get it from Supabase -> Project Settings -> Database -> Connection string (URI).
# On Render's starter plan, use the "Transaction pooler" connection string, not the direct one —
# it handles the short-lived connections a free/starter dyno makes much better.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres

# Optional: absolute path to a persistent disk mount (used on Render, see render.yaml).
# Selfie photos still get saved to disk (not to Supabase), so this still matters —
# leave unset for local dev, photos just get saved inside the backend folder.
# DATA_DIR=/var/data

# JWT secret - long random string used to sign secure login tokens (JWT authentication)
# Generate your own strong random value (e.g. `openssl rand -hex 48`) and never share it publicly.
JWT_SECRET=replace-with-your-own-long-random-secret

# Set this to "production" on your live/deployed server. When set, the app REFUSES to start
# if ADMIN_PASSWORD / MANAGER_PASSWORD are left unset (so a live server never accidentally
# runs with the well-known default password). Leave unset for local dev.
NODE_ENV=production

# Default admin login (used only the FIRST time server runs / seed script runs)
# Required in production — must be 8+ characters with at least one letter and one number.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Default manager login (used only the FIRST time server runs / seed script runs)
# Required in production — same password rule as above.
MANAGER_USERNAME=manager
MANAGER_PASSWORD=change-this-password

# ---------------------------------------------------------------------------------------
# MULTI-COMPANY (MULTI-TENANT) SETTINGS — this app can be sold/deployed to multiple
# companies from one shared deployment. See routes/companies.js and the Companies panel
# (accessible via the "Platform Owner Login" link on the sign-in screen, or /owner).
# ---------------------------------------------------------------------------------------

# Platform owner login (YOUR login — used only to add/manage the companies you sell this
# app to). Required in production — same password rule as ADMIN_PASSWORD above.
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_PASSWORD=change-this-password

# The very first/demo company created automatically on first boot (its Admin/Manager use
# ADMIN_USERNAME/ADMIN_PASSWORD and MANAGER_USERNAME/MANAGER_PASSWORD above, with this as
# its Company Code). Add real customer companies afterwards from the Companies panel above.
DEFAULT_COMPANY_NAME=Geovixa
DEFAULT_COMPANY_CODE=GEOVIXA

# Company / Project name shown in portal
PROJECT_NAME=Geovixa
COMPANY_NAME=Geovixa

# ---------------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS — fully OPTIONAL. Leave all of these unset and the app works exactly
# the same, it just won't send: (1) a welcome email to a new company's contact address when
# the super_admin creates them, and (2) Leave/Grievance/Salary-Slip approve-or-reject status
# emails to employees (only for employees who have an email on file). Works with any standard
# SMTP provider — Gmail App Passwords, SendGrid, Mailgun, Amazon SES, your own mail server, etc.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-smtp-password-or-api-key
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Geovixa

# ---------------------------------------------------------------------------------------
# DATABASE BACKUP — fully OPTIONAL, but strongly recommended in production. See
# scripts/backup-db.js and the `geovixa-db-backup` Cron Job in render.yaml.
# Without these set, backups are LOCAL-ONLY (written under backend/backups/) — fine for a
# host with a persistent disk, but on Render (both the web service's free tier AND its Cron
# Job resource) the filesystem is wiped on every restart/run, so a local-only backup there
# gives a false sense of safety. Set these to actually protect your data:
# ---------------------------------------------------------------------------------------
# Any S3-compatible bucket works: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# Supabase Storage's S3-compatible endpoint, MinIO, etc.
# BACKUP_S3_BUCKET=my-geovixa-backups
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_REGION=ap-south-1
# BACKUP_S3_ACCESS_KEY_ID=your-access-key-id
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-access-key
# How many local backups to keep before rotating out old ones (default 14 if unset):
# BACKUP_KEEP_COUNT=14
